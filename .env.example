# API Key for API Server authentication
API_KEY=YOUR_SECURE_API_KEY_HERE

# Port for HTTP API Server (default: 4000)
PORT=4000

# Salesforce Org Alias & Instance URL
ORG_ALIAS=OmkarSFDC
SF_INSTANCE_URL=https://ideas-sas.my.salesforce.com

# Database File Paths
DB_FILE=salesforce_data.db
APP_DB_FILE=app.db
ALERTS_FILE=acknowledged_alerts.json

# Cron Schedules
SYNC_CRON=*/2 * * * *
RECONCILIATION_CRON=0 */6 * * *
ARCHIVE_CRON=59 23 * * *

# Retry & Backoff Configuration for Salesforce API
MAX_RETRIES=3
RETRY_INITIAL_DELAY_MS=1000

# Capacity Threshold for Workload Forecasting in Dashboard
CAPACITY_LIMIT=15

# Monitored Owners & Chain Codes (comma-separated lists)
MONITORED_OWNERS=Saurabh Thakare,Afroz Khan,Swapnil Satpute,Sandesh Shahapurkar,Omkar Chitnis,Omkar Shete,Manoj Shinde,Bipinchandra Khangar,Kishore Fukate,Vinay Anavatti,care department,Vishal Goyal,Vikash Yadav,Karteek Desai
MONITORED_CHAINS=SCAN,TLUK,FOUR,LGPBV,OMNI,APPC,SON,ASC,KLH,WELCOME

# Microsoft Teams / Power Automate Webhook URLs
TEAMS_WEBHOOK_URL=https://your-teams-webhook-url
TEAMS_SHIFT_SUMMARY_WEBHOOK_URL=https://your-shift-summary-webhook-url

# Direct Salesforce API Credentials (Headless / Fallback)
SFDC_INSTANCE_URL=https://ideas-sas.my.salesforce.com
SFDC_USERNAME=your.salesforce.username@ideas.com
SFDC_PASSWORD=YourSecurePasswordAndSecurityToken
SFDC_ACCESS_TOKEN=
